   "group": "World: Blocks",
   "lines": [
    {
     "id": "blocks-name",
     "text": "Blocks.",
     "note": "Said when the world is switched"
    },
    {
     "id": "blocks-count",
     "text": "Put the blocks in the chest. Count them as you go.",
     "note": ""
    },
    {
     "id": "blocks-count-q",
     "text": "How many blocks are in the chest?",
     "note": ""
    },
    {
     "id": "blocks-how-many",
     "text": "How many blocks?",
     "note": ""
    },
    {
     "id": "blocks-make-many",
     "text": "blocks in the chest.",
     "note": "Follows \"Put\" and a number, e.g. \"Put six…\""
    },
    {
     "id": "blocks-make-one",
     "text": "block in the chest.",
     "note": "Follows \"Put one…\""
    },
    {
     "id": "blocks-more",
     "text": "Which chest has more?",
     "note": ""
    },
    {
     "id": "blocks-fewer",
     "text": "Which chest has fewer?",
     "note": ""
    },
    {
     "id": "blocks-add",
     "text": "Put them all in the big chest.",
     "note": ""
    },
    {
     "id": "blocks-add-q",
     "text": "How many blocks altogether?",
     "note": ""
    },
    {
     "id": "blocks-take",
     "text": "out of the chest.",
     "note": "Follows \"Take\" and a number, e.g. \"Take three…\""
    },
    {
     "id": "blocks-take-q",
     "text": "How many blocks are left in the chest?",
     "note": ""
    },
    {
     "id": "blocks-go-away",
     "text": "blocks go away.",
     "note": "Follows a number, e.g. \"Three…\""
    },
    {
     "id": "blocks-goes-away",
     "text": "block goes away.",
     "note": "Follows \"One…\""
    }
   ]
